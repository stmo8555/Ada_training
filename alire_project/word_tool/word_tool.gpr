with "config/word_tool_config.gpr";
project Word_Tool is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Word_Tool_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("word_tool.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Word_Tool_Config.Ada_Compiler_Switches & ("-gnatef");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Word_Tool;
