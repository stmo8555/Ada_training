with "config/bytecode_vm_config.gpr";
project Bytecode_Vm is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Bytecode_Vm_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("bytecode_vm.adb");

   package Compiler is
      for Default_Switches ("Ada") use Bytecode_Vm_Config.Ada_Compiler_Switches & ("-gnatef");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Bytecode_Vm;
